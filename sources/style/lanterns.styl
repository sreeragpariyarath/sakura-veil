// Festival lantern cards: light paper look to match the bright festival (final design in roadmap M3.2)
.lantern-card
    .content
        width 520px
        max-width calc(100vw - 40px)
        color #3a2a33
        background linear-gradient(#fff8f0, #ffeef3)
        border-top 6px solid #e8506e
        border-radius 6px

        .close
            filter invert(0.75)

        .kicker
            font-size 0.9rem
            letter-spacing 0.1em
            text-transform uppercase
            color #e8506e

        .title
            font-size 2.4rem
            margin 0.2rem 0 1rem 0

        .text
            line-height 1.6

// Story lines on the cherry blossom scroll (StoryText.js, image: static/images/ui/scroll-banner.webp)
.story-text
    position fixed
    top 70px
    left 50%
    width @css{ min(620px, calc(100vw - 24px)) }
    aspect-ratio 2 / 1
    pointer-events none
    opacity 0
    transform translateX(-50%) scale(0.6, 0.85)
    transition opacity 0.7s, transform 0.7s cubic-bezier(0.3, 1.4, 0.6, 1)

    &.is-visible
        opacity 1
        transform translateX(-50%) scale(1, 1)

    @media only screen and (max-width 520px)
        top 120px // Below the lantern counter and the menu buttons

    .scroll
        display flex
        flex-direction column
        align-items center
        justify-content center
        width 100%
        height 100%
        padding 12% 16% 10% 16% // Keeps the text on the paper (about 23–80% of the image height), inside the rollers
        background url('/images/ui/scroll-banner.webp') center / 100% 100% no-repeat
        filter drop-shadow(0 6px 14px rgba(120, 30, 50, 0.25))
        text-align center
        font-family Georgia, "Times New Roman", serif
        color #6e1b2e

    .title
        font-size @css{ clamp(0.95rem, 4.2vw, 1.6rem) }
        font-weight 700
        line-height 1.15
        color #8c1d3a
        text-shadow 0 1px 0 rgba(255, 255, 255, 0.6)

    .divider
        display flex
        align-items center
        width 70%
        margin 0.35em 0

        &::before
        &::after
            content ''
            flex 1
            height 1px
            background #8c1d3a
            opacity 0.6

        span
            width 7px
            height 7px
            margin 0 8px
            background #c2304f
            transform rotate(45deg)

    .subtitle
        font-size @css{ clamp(0.72rem, 2.8vw, 0.95rem) }
        line-height 1.35

// Lantern counter HUD (LanternCounter.js)
.lantern-counter
    position fixed
    top 20px
    left 20px
    display flex
    align-items center
    gap 4px
    padding 6px 12px 6px 8px
    border-radius 2rem
    background rgba(255, 248, 240, 0.8)
    pointer-events none

    .icon
        width 20px
        height 27px

        svg
            width 100%
            height 100%

        .roof
        .post
            fill #6b4a5a
            opacity 0.45

        .glass
            fill #ffffff
            stroke #6b4a5a
            stroke-width 1
            opacity 0.6
            transition fill 0.6s, opacity 0.6s, filter 0.6s

        &.is-lit
            .roof
            .post
                opacity 1

            .glass
                fill #ffb347
                opacity 1
                filter drop-shadow(0 0 3px #ffb347)

    .label
        margin-left 6px
        color #3a2a33
        font-weight 700
        font-size 0.9rem
