// Festival lantern cards: light paper look to match the bright festival (final design in roadmap M3.2)
.lantern-card
    .content
        width 520px
        max-width calc(100vw - 40px)
        color #3a2a33
        background linear-gradient(#fff8f0, #ffeef3)
        border-top 6px solid #e8506e
        border-radius 6px

        .close
            filter invert(0.75)

        .kicker
            font-size 0.9rem
            letter-spacing 0.1em
            text-transform uppercase
            color #e8506e

        .title
            font-size 2.4rem
            margin 0.2rem 0 1rem 0

        .text
            line-height 1.6

// Story lines (StoryText.js)
.story-text
    position fixed
    top 90px
    left 50%
    max-width calc(100vw - 40px)
    padding 0.5rem 1.4rem 0.6rem 1.4rem
    border-radius 2rem
    background rgba(255, 248, 240, 0.88)
    box-shadow 0 4px 20px rgba(232, 80, 110, 0.25)
    color #3a2a33
    font-size 1.3rem
    font-weight 700
    text-align center
    pointer-events none
    opacity 0
    transform translate(-50%, -10px)
    transition opacity 0.6s, transform 0.6s

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

    @media only screen and (max-width 520px)
        top 70px
        font-size 1.1rem

// Lantern counter HUD (LanternCounter.js)
.lantern-counter
    position fixed
    top 20px
    left 20px
    display flex
    align-items center
    gap 4px
    padding 6px 12px 6px 8px
    border-radius 2rem
    background rgba(255, 248, 240, 0.8)
    pointer-events none

    .icon
        width 20px
        height 27px

        svg
            width 100%
            height 100%

        .roof
        .post
            fill #6b4a5a
            opacity 0.45

        .glass
            fill #ffffff
            stroke #6b4a5a
            stroke-width 1
            opacity 0.6
            transition fill 0.6s, opacity 0.6s, filter 0.6s

        &.is-lit
            .roof
            .post
                opacity 1

            .glass
                fill #ffb347
                opacity 1
                filter drop-shadow(0 0 3px #ffb347)

    .label
        margin-left 6px
        color #3a2a33
        font-weight 700
        font-size 0.9rem
