// Festival lantern cards on the card frame (static/images/ui/card-frame.webp, 1400 × 677), as a 9-slice border image:
// corners keep their size (including the painted ✕); a clean 8 px band (y 357–365, inserted by
// scripts/card-frame-band.cjs) stretches so longer text makes the card taller. Past the screen height the body scrolls.
// --w is the card width; --u is one image pixel at that width.
.lantern-card
    .container
        --w @css{ min(760px, calc(100vw - 24px)) }
        --u @css{ calc(var(--w) / 1400) }

    .content
        position relative
        width var(--w)
        min-height @css{ calc(var(--u) * 677) }
        // Text stays on the paper, clear of the corner flowers (top-left to x 290) and the right-side flowers (from x 1170)
        padding @css{ calc(var(--u) * 115) calc(var(--u) * 230) calc(var(--u) * 150) calc(var(--u) * 290) }
        color #4a2530
        background none
        border-style solid
        border-color transparent
        border-width 1px // The art is painted by border-image-width over the whole card, not inside thick borders
        border-image @css{ url('/images/ui/card-frame.webp') 357 250 312 330 fill / calc(var(--u) * 357) calc(var(--u) * 250) calc(var(--u) * 312) calc(var(--u) * 330) stretch }
        box-sizing border-box

        > *
            position relative
            z-index 1

        // Scrolls inside the paper when the text is taller than the screen allows
        .card-body
            max-height @css{ calc(100vh - 40px - var(--u) * 265) }
            overflow-y auto
            scrollbar-width thin
            scrollbar-color #c2304f transparent

        // Invisible button over the painted ✕ (centre 1260, 137; about 90 px)
        .close
            position absolute
            top @css{ calc(var(--u) * 92) }
            right @css{ calc(var(--u) * 95) }
            width @css{ calc(var(--u) * 90) }
            height @css{ calc(var(--u) * 90) }
            opacity 1
            transform rotate(45deg)
            border-radius @css{ calc(var(--u) * 10) }

            .icon
                display none

            html:not(.is-mode-touch) &:hover
                background rgba(255, 255, 255, 0.25)

        .kicker
            font-family "Festival Brush", Georgia, serif
            font-size @css{ clamp(0.75rem, calc(var(--u) * 30), 1rem) }
            letter-spacing 0.06em
            color #c2304f

        .title
            font-family "Festival Brush", Georgia, serif
            font-size @css{ clamp(1.5rem, calc(var(--u) * 78), 2.6rem) } // Scales with the card on phones
            font-weight 400
            line-height 1.1
            color #8c1d3a
            margin 0.1rem 0 0.8rem 0

        .text
            font-family Georgia, "Times New Roman", serif
            font-size @css{ clamp(0.85rem, calc(var(--u) * 30), 1.05rem) }
            line-height 1.65

// Story lines (StoryText.js): scroll for big moments, single-line banner for short updates.
// Sizes use container units (cqw = 1% of the frame width) so text scales with the artwork.
// Enter: the frame unrolls from the centre, then the text fades in. Exit: text fades, the frame rolls up.
.story-text
    --ease-unroll cubic-bezier(0.65, 0, 0.35, 1)
    position fixed
    top 115px // Below the lantern counter
    left 50%
    width @css{ min(880px, calc(100vw - 24px)) }
    aspect-ratio 2 / 1
    container-type inline-size
    pointer-events none
    transform translate(-50%, -16px)
    opacity 0
    transition opacity 0.5s ease 0.6s, transform 0.9s ease 0.3s

    &.is-visible
        opacity 1
        transform translate(-50%, 0)
        transition opacity 0.35s ease, transform 0.9s cubic-bezier(0.3, 1.3, 0.6, 1)

    @media only screen and (max-width 520px)
        top 140px // Below the lantern counter and the menu buttons

    .frame
        display flex
        flex-direction column
        align-items center
        justify-content center
        width 100%
        height 100%
        padding 12% 16% 10% 16% // Keeps the text on the paper (about 23–80% of the image height), inside the rollers
        background url('/images/ui/scroll-banner.webp') center / 100% 100% no-repeat
        filter drop-shadow(0 6px 14px rgba(120, 30, 50, 0.25))
        text-align center
        color #6e1b2e
        clip-path inset(0 50% 0 50%)
        transition clip-path 0.7s var(--ease-unroll) 0.25s

    &.is-visible .frame
        clip-path inset(0 0 0 0)
        transition clip-path 1s var(--ease-unroll)

    .title
    .divider
    .subtitle
        opacity 0
        transform translateY(6px)
        transition opacity 0.3s ease, transform 0.3s ease

    &.is-visible
        .title
        .divider
        .subtitle
            opacity 1
            transform translateY(0)
            transition opacity 0.6s ease 0.75s, transform 0.6s ease 0.75s

        .subtitle
            transition-delay 0.9s

    .title
        margin 0
        font-family "Festival Brush", Georgia, serif // Overrides the global .title (Amatic SC)
        font-weight 400
        font-size 6.4cqw
        line-height 1.1
        word-spacing 0.12em // The brush capitals swash into the next word
        color #8c1d3a
        text-shadow 0 1px 0 rgba(255, 255, 255, 0.7)

    .divider
        display flex
        align-items center
        width 62%
        margin 0.5em 0 0.4em 0

        &::before
        &::after
            content ''
            flex 1
            height 1px
            background #8c1d3a
            opacity 0.6

        span
            width 1.1cqw
            height 1.1cqw
            margin 0 1.2cqw
            background #c2304f
            transform rotate(45deg)

    .subtitle
        font-family "Festival Brush", Georgia, serif
        font-size 3.7cqw
        line-height 1.3

    // Single-line banner (banner-single-line.webp, 900 × 255; paper from 12% to 91% wide, 25% to 68% high).
    // Unfurls from the left instead of the centre.
    &.is-banner
        width @css{ min(680px, calc(100vw - 24px)) }
        aspect-ratio 900 / 255

        .frame
            flex-direction row
            align-items baseline
            justify-content center
            gap 2.2cqw
            padding 7.5% 10% 0 15%
            background-image url('/images/ui/banner-single-line.webp')
            clip-path inset(0 100% 0 0)

        &.is-visible .frame
            clip-path inset(0 0 0 0)

        .divider
            display none

        .title
            font-size 5.8cqw
            white-space nowrap

        .subtitle
            font-size 5cqw
            color #c2304f
            white-space nowrap

// Lantern progress bar (LanternCounter.js, lantern-progress-bar.webp, 900 × 173)
.lantern-counter
    position fixed
    top 12px
    left 8px
    width @css{ min(500px, calc(100vw - 70px)) }
    aspect-ratio 900 / 173
    container-type inline-size
    background url('/images/ui/lantern-progress-bar.webp') center / 100% 100% no-repeat
    filter drop-shadow(0 4px 10px rgba(120, 30, 50, 0.25))
    pointer-events none
    opacity 0
    transform translateY(-12px)
    transition opacity 1.4s ease, transform 1.4s ease

    &.is-visible
        opacity 1
        transform translateY(0)

    // Warm light over a painted lantern's glass
    .glow
        position absolute
        top 38.5%
        width 9%
        aspect-ratio 1
        border-radius 50%
        background radial-gradient(circle, rgba(255, 236, 170, 1) 0%, rgba(255, 170, 60, 0.85) 35%, rgba(255, 120, 40, 0) 70%)
        mix-blend-mode screen
        opacity 0
        transform translate(-50%, -50%) scale(0.4)
        transition opacity 1.2s ease, transform 1.2s cubic-bezier(0.3, 1.6, 0.6, 1)

        &.is-lit
            opacity 1
            transform translate(-50%, -50%) scale(1)

    // Count on the plaque (80.9–97.7% wide, 23–68% high)
    .label
        position absolute
        left 80.9%
        top 23.4%
        width 16.8%
        height 44%
        display flex
        align-items center
        justify-content center
        font-family "Festival Brush", Georgia, serif
        font-size 5.4cqw
        line-height 1
        white-space nowrap
        color #8c1d3a

        &.is-bump
            animation lantern-counter-bump 0.6s ease

@keyframes lantern-counter-bump
    0%
        transform scale(1)
    40%
        transform scale(1.35)
    100%
        transform scale(1)

// Music button (FestivalMusic.js), same look as the map button, one slot lower
.music-trigger
    top 120px

    .music-icon
        width 22px
        height 22px

        .slash
            transition opacity 0.3s

    &.is-playing .music-icon .slash
        opacity 0
